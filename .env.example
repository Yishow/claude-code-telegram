# Claude Code Telegram Bot 設定檔
#
# 本機器人讓你透過 Telegram 遠端操控 Claude Code，提供以下功能：
# - 類終端機介面，可直接下達 Claude 指令
# - 檔案上傳與壓縮包自動解壓縮
# - Git 儲存庫整合（唯讀 Git 操作）
# - 快速動作按鈕，方便執行常用指令
# - 對話記錄匯出（支援多種格式）
# - 圖片 / 截圖分析
# - 智慧後續建議（對話提示）

# ==========================================
# === 認證設定（擇一使用）                ===
# ==========================================
#
# 方法一（推薦）：沿用已登入的 Claude CLI 帳號
#   1. 安裝 Claude CLI：https://claude.ai/code
#   2. 登入：claude auth login
#   3. 設定 USE_SDK=true，並將 ANTHROPIC_API_KEY 留空
#
# 方法二：直接使用 API 金鑰
#   1. 至 Anthropic 控制台取得金鑰：https://console.anthropic.com/
#   2. 設定 USE_SDK=true 並填入 ANTHROPIC_API_KEY
#
# 方法三：CLI 子行程模式（舊版相容模式）
#   1. 安裝並完成 Claude CLI 登入認證
#   2. 設定 USE_SDK=false

# ==========================================
# === 必要設定                            ===
# ==========================================

# Telegram Bot Token，由 @BotFather 建立機器人後取得
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 機器人使用者名稱（不含 @ 符號，例如：my_claude_bot）
TELEGRAM_BOT_USERNAME=your_bot_username

# 允許機器人存取的專案根目錄（絕對路徑）
# 機器人只能讀寫此目錄及其子目錄內的檔案
# 範例：/home/user/projects 或 /srv/workspaces
APPROVED_DIRECTORY=/path/to/your/projects

# ==========================================
# === 安全設定                            ===
# ==========================================

# 允許使用本機器人的 Telegram 使用者 ID（以逗號分隔）
# 留空表示開放給所有人使用（正式環境不建議）
# 可透過 @userinfobot 查詢自己的使用者 ID
ALLOWED_USERS=123456789,987654321

# 是否啟用 Token 身分驗證機制
# 啟用後，使用者需提供有效 Token 才能操作機器人
ENABLE_TOKEN_AUTH=false

# 用於產生驗證 Token 的密鑰（啟用 ENABLE_TOKEN_AUTH=true 時必填）
# 建議使用以下指令產生隨機密鑰：openssl rand -hex 32
AUTH_TOKEN_SECRET=

# 是否停用路徑與指令的危險字元驗證（僅適用於受信任的私有環境）
# 警告：停用後，驗證輸入中將允許管道符號（|）、重新導向（>）等特殊字元
# 正式或多人共用環境請維持 false
DISABLE_SECURITY_PATTERNS=false

# 是否停用 Claude 工具允許／拒絕清單驗證（僅適用於受信任的私有環境）
# 警告：僅跳過工具名稱的允許／拒絕檢查；路徑與指令的安全驗證仍會執行
DISABLE_TOOL_VALIDATION=false

# ==========================================
# === Claude 設定                         ===
# ==========================================

# Claude 整合方式
# true  → 使用 Python SDK（推薦，支援更豐富功能）
# false → 使用 CLI 子行程模式（舊版相容）
USE_SDK=true

# Anthropic API 金鑰（使用 SDK 模式且未透過 CLI 登入時填寫）
# 取得金鑰：https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude CLI 執行檔路徑（選填，留空則自動偵測）
# 範例：/usr/local/bin/claude 或 ~/.nvm/versions/node/v20.19.2/bin/claude
CLAUDE_CLI_PATH=

# Claude CLI 舊版執行檔路徑（已棄用，請改用 CLAUDE_CLI_PATH）
CLAUDE_BINARY_PATH=

# 使用的 Claude 模型名稱
# 範例：claude-opus-4-5、claude-3-5-sonnet-20241022
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# 單一對話允許的最大回合數，超過後需開啟新對話
CLAUDE_MAX_TURNS=10

# Claude 單次操作的逾時時間（秒）
# 複雜任務建議調高此值
CLAUDE_TIMEOUT_SECONDS=300

# 每位使用者的最高花費上限（美元）
# 超過後該使用者的請求將被拒絕
CLAUDE_MAX_COST_PER_USER=10.0

# Claude 可使用的工具清單（以逗號分隔）
# 移除不需要的工具名稱可限縮機器人的操作範圍
CLAUDE_ALLOWED_TOOLS=Read,Write,Edit,Bash,Glob,Grep,LS,Task,TaskOutput,MultiEdit,NotebookRead,NotebookEdit,WebFetch,TodoRead,TodoWrite,WebSearch,Skill,AskUserQuestion,EnterPlanMode,ExitPlanMode

# 明確禁止 Claude 使用的工具清單（以逗號分隔，選填）
# 優先順序高於 CLAUDE_ALLOWED_TOOLS，可用來封鎖特定指令
CLAUDE_DISALLOWED_TOOLS=

# ==========================================
# === Copilot 設定（選填）                ===
# ==========================================

# Copilot CLI 執行檔路徑（選填，留空則自動偵測）
COPILOT_BINARY_PATH=

# 預設使用的 Copilot 模型
# 可用模型清單請執行：copilot --help
COPILOT_MODEL=gpt-5.3-codex

# 預設 AI 提供者
# 可選值：「claude」或「copilot」
DEFAULT_PROVIDER=claude

# Copilot 備援模式（SDK 呼叫失敗時的處理策略）
# sdk_only      → SDK 失敗時直接回報錯誤，不嘗試備援
# sdk_then_cli  → SDK 失敗後自動切換到 Copilot CLI 重試
COPILOT_FALLBACK_MODE=sdk_then_cli

# 外部 Copilot CLI 伺服器端點（選填，通常不需填寫）
COPILOT_EXTERNAL_CLI_SERVER=

# Copilot 設定目錄策略
# global      → 使用 SDK 預設的全域設定路徑
# per_project → 每個工作區各自隔離的認證與快取
COPILOT_CONFIG_DIR_POLICY=global

# Copilot 預設推理強度
# 可選值：low（快速）| medium（均衡）| high（深度）| xhigh（最高）
COPILOT_REASONING_DEFAULT=medium

# 是否啟用 Copilot SDK 的預發布功能（preview / alpha / beta / rc）
# 非必要請維持 false，以確保穩定性
COPILOT_ENABLE_PRERELEASE_FEATURES=false

# Copilot 執行環境的技能目錄（以逗號分隔，選填）
# 範例：/path/to/skills,/another/skills
COPILOT_SKILL_DIRECTORIES=

# Copilot 執行環境中要停用的技能（以逗號分隔，選填）
COPILOT_DISABLED_SKILLS=

# Copilot 持久化 Session 對應表的儲存路徑
COPILOT_SESSION_STORE_PATH=data/copilot-session-map.json

# 是否啟用 Copilot 無限 Session 模式（自動壓縮上下文以維持持續對話）
COPILOT_INFINITE_SESSIONS=true

# 觸發背景壓縮的上下文使用率閾值（0.0~1.0）
# 當上下文使用量超過此比例時，自動執行壓縮以釋放空間
# 範例：0.80 表示使用超過 80% 時觸發壓縮
COPILOT_COMPACTION_THRESHOLD=0.80

# ==========================================
# === 沙盒設定                            ===
# ==========================================

# 是否啟用 OS 層級的 Bash 沙盒（限制 Claude 的 Bash 工具只能在 APPROVED_DIRECTORY 內執行）
# 正式環境建議保持 true 以防止越權存取
SANDBOX_ENABLED=true

# 排除在沙盒限制之外的指令（以逗號分隔）
# 這些指令需要存取系統資源，因此允許在沙盒外執行
# 範例：git,npm,pip,poetry,make,docker
SANDBOX_EXCLUDED_COMMANDS=git,npm,pip,poetry,make,docker

# ==========================================
# === 速率限制                            ===
# ==========================================

# 在時間窗口內允許的最大請求數
RATE_LIMIT_REQUESTS=10

# 速率限制的時間窗口長度（秒）
RATE_LIMIT_WINDOW=60

# 速率限制的突發容量（短時間內可超出的額外請求數）
RATE_LIMIT_BURST=20

# ==========================================
# === 儲存設定                            ===
# ==========================================

# 資料庫連線字串（預設使用 SQLite，無需額外安裝）
# SQLite 範例：sqlite:///data/bot.db
# PostgreSQL 範例：postgresql://user:password@localhost/dbname
DATABASE_URL=sqlite:///data/bot.db

# 對話 Session 的逾時時間（小時）
# 超過此時間未活動的 Session 將被自動清除
SESSION_TIMEOUT_HOURS=24

# 對話 Session 的逾時時間（分鐘，範圍：10–1440）
# 若與 SESSION_TIMEOUT_HOURS 同時設定，以此為準
SESSION_TIMEOUT_MINUTES=120

# 每位使用者最多可同時開啟的 Session 數量
MAX_SESSIONS_PER_USER=5

# ==========================================
# === 功能開關                            ===
# ==========================================

# 是否啟用 Model Context Protocol（MCP）
# MCP 可擴充 Claude 的工具與上下文來源能力
ENABLE_MCP=false

# MCP 設定檔路徑（啟用 MCP 時指定）
MCP_CONFIG_PATH=

# MCP 環境變數的傳遞模式（供 Copilot 整合使用）
# raw    → 直接傳遞原始值
# masked → 遮蔽敏感值後傳遞
# omit   → 完全不傳遞環境變數
MCP_ENV_VALUE_MODE=raw

# 是否啟用 Git 整合（唯讀的 Git 操作，例如：log、diff、status）
ENABLE_GIT_INTEGRATION=true

# 是否允許使用者上傳檔案（含壓縮包自動解壓縮功能）
ENABLE_FILE_UPLOADS=true

# 是否顯示快速動作按鈕（根據情境動態顯示常用操作）
ENABLE_QUICK_ACTIONS=true

# 是否啟用對話式代理模式（Agentic Mode）
# true  → 對話式代理模式（預設，支援多輪任務執行）
# false → 經典單一指令模式
AGENTIC_MODE=true

# 機器人輸出的詳細程度
# 0 → 安靜模式（只顯示最終回應）
# 1 → 一般模式（顯示工具名稱與推理摘要）
# 2 → 詳細模式（顯示工具輸入內容與完整推理）
VERBOSE_LEVEL=1

# ==========================================
# === 進階功能設定                        ===
# ==========================================

# 單一檔案上傳的最大大小（MB），壓縮包同樣受此限制
MAX_FILE_UPLOAD_SIZE_MB=100

# 壓縮包解析時預覽的最大檔案數量
MAX_ARCHIVE_PREVIEW_FILES=5

# 是否啟用對話記錄匯出功能
ENABLE_SESSION_EXPORT=true

# 是否允許使用者上傳圖片或截圖供 Claude 分析
ENABLE_IMAGE_UPLOADS=true

# 是否啟用對話增強功能（包含智慧後續建議提示）
ENABLE_CONVERSATION_MODE=true

# 快速動作按鈕的操作逾時時間（秒）
QUICK_ACTIONS_TIMEOUT=120

# Git 操作的逾時時間（秒）
GIT_OPERATIONS_TIMEOUT=30

# ==========================================
# === 專案主題模式（Project Thread Mode） ===
# ==========================================

# 是否啟用依 Telegram 專案主題進行嚴格路由
# 啟用後，每個專案對應一個獨立的聊天主題
ENABLE_PROJECT_THREADS=false

# 主題模式選擇
# private → 在機器人私聊中使用主題（Bot Chat Topics，主要模式）
# group   → 在超級群組的論壇主題中使用
PROJECT_THREADS_MODE=private

# 目標 Telegram 論壇 / 超級群組的 Chat ID（僅 PROJECT_THREADS_MODE=group 時需填）
# 格式為負數，例如：-1001234567890
PROJECT_THREADS_CHAT_ID=

# 專案設定檔路徑（YAML 格式，範例請參考 config/projects.example.yaml）
PROJECTS_CONFIG_PATH=

# 同步主題期間，兩次 Telegram API 呼叫之間的最小間隔（秒）
# 設為 0 可停用節流限制；建議保持預設值以避免觸發 Telegram API 限流
PROJECT_THREADS_SYNC_ACTION_INTERVAL_SECONDS=1.1

# ==========================================
# === API 伺服器與排程器（進階）          ===
# ==========================================

# 是否啟用 FastAPI Webhook 伺服器（供外部系統主動呼叫機器人）
ENABLE_API_SERVER=false

# FastAPI API 伺服器的監聽連接埠
API_SERVER_PORT=8080

# 是否啟用背景排程器（定時任務功能）
ENABLE_SCHEDULER=false

# GitHub Webhook 的 HMAC 密鑰（用於驗證 GitHub 送來的 Webhook 請求）
# 留空則不驗證 GitHub Webhook 簽章
GITHUB_WEBHOOK_SECRET=

# 通用 Webhook 提供者的共用密鑰（用於驗證第三方 Webhook 請求）
WEBHOOK_API_SECRET=

# 機器人主動通知的目標 Telegram 聊天 ID（以逗號分隔，選填）
# 這些聊天室將接收機器人的主動推送訊息（例如排程任務結果）
# 範例：123456789,-1001234567890
NOTIFICATION_CHAT_IDS=

# ==========================================
# === 監控與日誌                          ===
# ==========================================

# 日誌記錄等級
# 可選值：DEBUG（最詳細）| INFO（一般）| WARNING（警告）| ERROR（僅錯誤）
LOG_LEVEL=INFO

# 是否啟用匿名遙測（用於改善服務，不含個人資料）
ENABLE_TELEMETRY=false

# Sentry 錯誤追蹤 DSN（選填，用於生產環境錯誤監控）
# 至 https://sentry.io/ 建立專案後取得 DSN
SENTRY_DSN=

# ==========================================
# === 開發設定                            ===
# ==========================================

# 執行環境
# 可選值：development（開發）| testing（測試）| production（正式）
ENVIRONMENT=development

# 是否啟用除錯模式（輸出更詳細的執行日誌）
DEBUG=false

# 是否啟用開發專用功能（正式環境應設為 false）
DEVELOPMENT_MODE=true

# ==========================================
# === Telegram 訊息接收模式               ===
# ==========================================

# Webhook URL 設定
# 留空 → 使用 Polling 輪詢模式（適合本機開發或無固定 IP 的環境）
# 填入公開 HTTPS URL → 切換為 Webhook 模式（適合正式部署，效率更高）
# 範例：https://bot.example.com/webhook
WEBHOOK_URL=

# Webhook 監聽的連接埠與路徑（僅 WEBHOOK_URL 有值時生效）
WEBHOOK_PORT=8443
WEBHOOK_PATH=/webhook

# Webhook 驗證用的密鑰 Token（選填，Webhook 模式下強烈建議設定）
# Telegram 會在每次請求的標頭 X-Telegram-Bot-Api-Secret-Token 中帶入此值
# 建議使用：openssl rand -hex 32 產生
TELEGRAM_WEBHOOK_SECRET_TOKEN=
